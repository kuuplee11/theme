eat(3, 1fr);\n    gap: 18px;\n    margin-bottom: 32px;\n  }\n\n  .aliviax-about__card,\n  .aliviax-about__value,\n  .aliviax-about__panel,\n  .aliviax-about__stat {\n    background: #fff;\n    border: 1px solid #e5e7eb;\n    border-radius: 22px;\n  }\n\n  .aliviax-about__card,\n  .aliviax-about__value {\n    padding: 24px;\n  }\n\n  .aliviax-about__card h3,\n  .aliviax-about__value h3 {\n    margin: 0 0 8px;\n    font-size: 20px;\n    line-height: 1.2;\n  }\n\n  .aliviax-about__card p,\n  .aliviax-about__value p {\n    margin: 0;\n    color: #6b7280;\n    line-height: 1.75;\n  }\n\n  .aliviax-about__story {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n    margin-bottom: 32px;\n  }\n\n  .aliviax-about__panel {\n    padding: 28px;\n  }\n\n  .aliviax-about__panel h2 {\n    margin: 0 0 14px;\n    font-size: clamp(24px, 4vw, 36px);\n    line-height: 1.1;\n  }\n\n  .aliviax-about__stats {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n    margin-top: 16px;\n  }\n\n  .aliviax-about__stat {\n    padding: 18px;\n    text-align: center;\n    background: #f9fafb;\n  }\n\n  .aliviax-about__stat strong {\n    display: block;\n    font-size: 28px;\n    line-height: 1;\n    margin-bottom: 6px;\n  }\n\n  .aliviax-about__stat span {\n    color: #6b7280;\n    font-size: 14px;\n  }\n\n  .aliviax-about__values {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    margin-bottom: 32px;\n  }\n\n  .aliviax-about__cta {\n    background: #d4af37;\n    color: #fff;\n    border-radius: 28px;\n    padding: 32px 22px;\n    text-align: center;\n  }\n\n  .aliviax-about__cta h2 {\n    margin: 0 0 10px;\n    font-size: clamp(26px, 4vw, 40px);\n    line-height: 1.1;\n  }\n\n  .aliviax-about__cta p {\n    margin: 0 auto 18px;\n    max-width: 60ch;\n    line-height: 1.8;\n    opacity: .92;\n  }\n\n  .aliviax-about__cta .aliviax-about__btn--primary {\n    background: #fff;\n    color: #0d1844;\n  }\n\n  @medi