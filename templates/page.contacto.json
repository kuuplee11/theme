-about__stats {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 14px;\n    margin-top: 16px;\n  }\n\n  .aliviax-about__stat {\n    padding: 18px;\n    text-align: center;\n    background: #f9fafb;\n  }\n\n  .aliviax-about__stat strong {\n    display: block;\n    font-size: 28px;\n    line-height: 1;\n    margin-bottom: 6px;\n    color: #d4af37;\n  }\n\n  .aliviax-about__stat span {\n    color: #6b7280;\n    font-size: 14px;\n  }\n\n  .aliviax-about__values {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    margin-bottom: 32px;\n  }\n\n  .aliviax-about__cta {\n    background: #d4af37;\n    color: #fff;\n    border-radius: 28px;\n    padding: 32px 22px;\n    text-align: center;\n  }\n\n  .aliviax-about__cta h2 {\n    margin: 0 0 10px;\n    font-size: clamp(26px, 4vw, 40px);\n    line-height: 1.1;\n    color: #fff;\n  }\n\n  .aliviax-about__cta p {\n    margin: 0 auto 18px;\n    max-width: 60ch;\n    line-height: 1.8;\n    opacity: .92;\n  }\n\n  .aliviax-about__cta .aliviax-about__btn--primary {\n    background: #fff;\n    color: #1a233a;\n  }\n\n  @media screen and (max-width: 989px) {\n    .aliviax-about__hero, .aliviax-about__grid, .aliviax-about__story, .aliviax-about__stats, .aliviax-about__values {\n      grid-template-columns: 1fr;\n    }\n    .aliviax-about__media img { width: 100%; height: auto; }\n  }\n<\/style>\n\n<section class=\"aliviax-about\">\n  <div class=\"aliviax-about__wrap\">\n    <div class=\"aliviax-about__hero\">\n      <div>\n        <div class=\"aliviax-about__eyebrow\">Estamos aqui para escucharte<\/div>\n        <h1 class=\"aliviax-about__title\">Contacto AliviaX<\/h1>\n        <p class=\"aliviax-about__text\">\n          ¿Tienes dudas sobre tu pedido o quieres saber más sobre AliviaX Pro? Nuestro equipo está listo para ofrecerte una atención cercana y profesional las 24 horas del día.\n        <\/p>\n        <div class=\"aliviax-about__buttons\">\n          <a href=\"mailto:cont