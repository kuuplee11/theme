/aliviax-pro\" class=\"is-active\">AliviaX Pro<\/a><\/li>\n          <li><a href=\"\/pages\/contact\">Contacto<\/a><\/li>\n          <li><a href=\"\/pages\/quienes-somos\">¿Quiénes Somos?<\/a><\/li>\n        <\/ul>\n      <\/nav>\n\n      <a href=\"{{ routes.cart_url }}\" class=\"alx-cart-btn alx-cart-btn--mobile\" aria-label=\"Ir a la cesta\">\n        <span class=\"alx-cart-btn__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 4H5.2L7 14H18.2L20.3 7H8.1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n            <circle cx=\"9.2\" cy=\"18.2\" r=\"1.6\" fill=\"currentColor\"\/>\n            <circle cx=\"17.2\" cy=\"18.2\" r=\"1.6\" fill=\"currentColor\"\/>\n          <\/svg>\n        <\/span>\n        <span class=\"alx-cart-btn__text\">Cesta<\/span>\n        <span class=\"alx-cart-btn__count\">{{ cart.item_count }}<\/span>\n      <\/a>\n    <\/div>\n  <\/div>\n<\/header>\n\n<style>\n  .shopify-section:has(.alx-header) {\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  :root {\n    --alx-bg: #ffffff;\n    --alx-bg-deep: #ffffff;\n    --alx-text: #121220;\n    --alx-text-soft: rgba(18, 18, 32, 0.65);\n    --alx-accent: #c25a70;\n    --alx-accent-2: #f5c6d0;\n    --alx-surface: rgba(18, 18, 32, 0.05);\n    --alx-border: rgba(18, 18, 32, 0.08);\n    --alx-shadow: 0 2px 24px rgba(18, 18, 32, 0.09);\n    --alx-radius: 999px;\n    --alx-container: 1320px;\n    --alx-transition: .35s cubic-bezier(.22, 1, .36, 1);\n  }\n\n  .alx-header {\n    position: sticky;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 50;\n    color: var(--alx-text);\n    background: linear-gradient(180deg, var(--alx-bg) 0%, var(--alx-bg-deep) 100%);\n    overflow: visible;\n    border-bottom: 1px solid #e6e0ec;\n    transition: top .38s cubic-bezier(.22,1,.36,1), box-shadow .25s ease;\n  }\n\n  .alx-header.alx-header--hidden {\n    top: -140px;\n  }\n\n  .alx-header.alx-header--scrolled {\n    box-shadow: 0 10px 30px rgba(0,0,0,.14);\n  }\n\n  .alx-header::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: transparent;\n    pointer-events: none;\n  }\n\n  .alx-container {\n    width: 100%;\n    max-width: var(--alx-container);\n    margin: 0 auto;\n    padding: 0 24px;\n    position: relative;\n  }\n\n  .alx-header__main {\n    padding: 18px 0;\n  }\n\n  .alx-header__inner {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: 180px;\n  }\n\n  .alx-logo {\n    justify-self: center;\n    text-decoration: none;\n    color: var(--alx-text);\n    font-size: 22px;\n    font-weight: 800;\n    letter-spacing: 0.05em;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .alx-logo span {\n    display: inline-block;\n    position: relative;\n  }\n\n  .alx-logo span::after {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    bottom: -10px;\n    transform: translateX(-50%);\n    width: 42px;\n    height: 2px;\n    border-radius: 999px;\n    background: linear-gradient(90deg, transparent, var(--alx-accent), transparent);\n  }\n\n  .alx-nav {\n    min-width: 0;\n  }\n\n  .alx-nav--left {\n    justify-self: end;\n  }\n\n  .alx-header__right {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 18px;\n    min-width: 0;\n  }\n\n  .alx-nav--right {\n    min-width: 0;\n  }\n\n  .alx-nav__list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex-wrap: wrap;\n  }\n\n  .alx-nav__link {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 42px;\n    padding: 0 14px;\n    border-radius: var(--alx-radius);\n    color: var(--alx-text-soft);\n    text-decoration: none;\n    font-size: 15px;\n    font-weight: 500;\n    position: relative;\n    transition: all var(--alx-transition);\n    white-space: nowrap;\n  }\n\n  .alx-nav__link:hover,\n  .alx-nav__link.is-active {\n    color: var(--alx-text);\n    background: var(--alx-surface);\n  }\n\n  .alx-nav__link.is-active::after,\n  .alx-nav__link:hover::after {\n    content: \"\";\n    position: absolute;\n    left: 14px;\n    right: 14px;\n    bottom: 7px;\n    height: 2px;\n    border-radius: 999px;\n    background: var(--alx-accent);\n  }\n\n  .alx-header__cta {\n    flex-shrink: 0;\n  }\n\n  .alx-cart-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    min-height: 46px;\n    padding: 0 14px 0 16px;\n    border-radius: 999px;\n    text-decoration: none;\n    color: var(--alx-text);\n    background: rgba(18,18,32,.04);\n    border: 1px solid rgba(18,18,32,.12);\n    box-shadow: 0 10px 30px rgba(0,0,0,0.12);\n    transition: transform var(--alx-transition), background var(--alx-transition), border-color var(--alx-transition);\n    white-space: nowrap;\n  }\n\n  .alx-cart-btn:hover {\n    transform: translateY(-2px);\n    background: rgba(18,18,32,.07);\n    border-color: rgba(18,18,32,.2);\n  }\n\n  .alx-cart-btn__icon {\n    width: 20px;\n    height: 20px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .alx-cart-btn__icon svg {\n    width: 20px;\n    height: 20px;\n    stroke: currentColor;\n  }\n\n  .alx-cart-btn__text {\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.01em;\n  }\n\n  .alx-cart-btn__count {\n    min-width: 24px;\n    height: 24px;\n    padding: 0 7px;\n    border-radius: 999px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(135deg, var(--alx-accent), var(--alx-accent-2));\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 800;\n    line-height: 1;\n  }\n\n  .alx-burger {\n    display: none;\n    width: 44px;\n    height: 44px;\n    border-radius: 12px;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    gap: 5px;\n    border: 0;\n    background: transparent;\n    color: var(--alx-text);\n    cursor: pointer;\n    flex-shrink: 0;\n  }\n\n  .alx-burger span {\n    display: block;\n    width: 20px;\n    height: 2px;\n    border-radius: 999px;\n    background: currentColor;\n    pointer-events: none;\n  }\n\n  .alx-mobile-drawer {\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    pointer-events: none;\n    visibility: hidden;\n    height: 100dvh;\n    transition: visibility 0s linear .38s;\n  }\n\n  .alx-mobile-drawer__overlay {\n    position: fixed;\n    inset: 0;\n    background: rgba(10, 14, 5, 0.65);\n    opacity: 0;\n    transition: opacity .28s ease;\n  }\n\n  .alx-mobile-drawer__panel {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: min(88vw, 340px);\n    height: 100dvh;\n    max-height: 100dvh;\n    overflow-y: auto;\n    background: #ffffff;\n    color: var(--alx-text);\n    transform: translateX(-100%);\n    transition: transform .38s cubic-bezier(.22,1,.36,1);\n    padding: 24px 18px;\n    box-shadow: 6px 0 40px rgba(0,0,0,0.5);\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    border-top-right-radius: 20px;\n    border-bottom-right-radius: 20px;\n  }\n\n  .alx-mobile-drawer.is-open {\n    pointer-events: auto;\n    visibility: visible;\n    transition: visibility 0s linear 0s;\n  }\n\n  .alx-mobile-drawer.is-open .alx-mobile-drawer__overlay {\n    opacity: 1;\n  }\n\n  .alx-mobile-drawer.is-open .alx-mobile-drawer__panel {\n    transform: translateX(0);\n  }\n\n  .alx-mobile-drawer__head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .alx-mobile-drawer__title {\n    font-size: 22px;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    color: var(--alx-text);\n  }\n\n  .alx-close {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    border-radius: 12px;\n    background: rgba(18,18,32,.05);\n    border: 1px solid rgba(18,18,32,.1);\n    color: var(--alx-text);\n    cursor: pointer;\n    font-size: 16px;\n    transition: background var(--alx-transition);\n  }\n\n  .alx-close:hover {\n    background: rgba(18,18,32,.1);\n  }\n\n  .alx-mobile-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    flex: 1;\n  }\n\n  .alx-mobile-list li + li {\n    margin-top: 8px;\n  }\n\n  .alx-mobile-list a {\n    display: flex;\n    align-items: center;\n    min-height: 50px;\n    padding: 0 16px;\n    border-radius: 14px;\n    text-decoration: none;\n    color: var(--alx-text);\n    font-size: 16px;\n    font-weight: 500;\n    background: rgba(18,18,32,.03);\n    border: 1px solid rgba(18,18,32,.06);\n    transition: background var(--alx-transition), border-color var(--alx-transition);\n  }\n\n  .alx-mobile-list a:hover,\n  .alx-mobile-list a.is-active {\n    background: rgba(18,18,32,.07);\n    border-color: rgba(18,18,32,.12);\n  }\n\n  .alx-cart-btn--mobile {\n    width: 100%;\n    justify-content: center;\n    margin-top: auto;\n  }\n\n  @media (max-width: 1180px) {\n    .alx-nav__link {\n      padding: 0 10px;\n      font-size: 14px;\n    }\n\n    .alx-header__right {\n      gap: 12px;\n    }\n  }\n\n  @media (max-width: 989px) {\n    .alx-header__inner {\n      grid-template-columns: 44px 1fr;\n      position: relative;\n    }\n\n    .alx-burger {\n      display: inline-flex;\n      grid-column: 1;\n      grid-row: 1;\n      z-index: 12;\n    }\n\n    .alx-logo {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      top: 50%;\n      margin-top: -11px;\n      z-index: 10;\n      font-size: 20px;\n    }\n\n    .alx-nav--left,\n    .alx-header__right {\n      display: none;\n    }\n  }\n\n  @media (max-width: 749px) {\n    .alx-container {\n      padding: 0 14px;\n    }\n\n    .alx-header__main {\n      padding: 13px 0;\n    }\n\n    .alx-logo {\n      font-size: 18px;\n    }\n  }\n<\/style>\n\n<script>\n(function () {\n  function initHeader() {\n    var header = document.getElementById('alx-header');\n    var burger = header ? header.querySelector('.alx-burger') : null;\n    var drawer = document.getElementById('alx-mobile-drawer');\n    var closeBtn = drawer ? drawer.querySelector('.alx-close') : null;\n    var overlay = drawer ? drawer.querySelector('.alx-mobile-drawer__overlay') : null;\n\n    if (!header || !burger || !drawer) return;\n\n    function openDrawer() {\n      drawer.classList.add('is-open');\n      drawer.setAttribute('aria-hidden', 'false');\n      burger.setAttribute('aria-expanded', 'true');\n      document.body.style.overflow = 'hidden';\n      header.classList.remove('alx-header--hidden');\n    }\n\n    function closeDrawer() {\n      drawer.classList.remove('is-open');\n      drawer.setAttribute('aria-hidden', 'true');\n      burger.setAttribute('aria-expanded', 'false');\n      document.body.style.overflow = '';\n    }\n\n    burger.addEventListener('click', function (e) {\n      e.preventDefault();\n      e.stopPropagation();\n      if (drawer.classList.contains('is-open')) {\n        closeDrawer();\n      } else {\n        openDrawer();\n      }\n    });\n\n    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);\n    if (overlay) overlay.addEventListener('click', closeDrawer);\n\n    document.addEventListener('keydown', function (e) {\n      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {\n        closeDrawer();\n      }\n    });\n\n    var lastScroll = 0;\n    var ticking = false;\n    var hideAfter = 140;\n    var delta = 6;\n\n    function updateHeader() {\n      var curr = window.pageYOffset || document.documentElement.scrollTop;\n\n      if (curr <= 0) {\n        header.classList.remove('alx-header--hidden');\n        header.classList.remove('alx-header--scrolled');\n        lastScroll = 0;\n        ticking = false;\n        return;\n      }\n\n      if (curr > 10) {\n        header.classList.add('alx-header--scrolled');\n      } else {\n        header.classList.remove('alx-header--scrolled');\n      }\n\n      if (drawer.classList.contains('is-open')) {\n        header.classList.remove('alx-header--hidden');\n        lastScroll = curr;\n        ticking = false;\n        return;\n      }\n\n      if (Math.abs(curr - lastScroll) <= delta) {\n        ticking = false;\n        return;\n      }\n\n      if (curr > lastScroll && curr > hideAfter) {\n        header.classList.add('alx-header--hidden');\n      } else if (curr < lastScroll) {\n        header.classList.remove('alx-header--hidden');\n      }\n\n      lastScroll = curr;\n      ticking = false;\n    }\n\n    window.addEventListener('scroll', function () {\n      if (!ticking) {\n        window.requestAnimationFrame(updateHeader);\n        ticking = true;\n      }\n    }, { passive: true });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initHeader);\n  } else {\n    initHeader();\n  }\n})();\n<\/script>","color_scheme":"","padding_top":0,"padding_bottom":0}}},"order":["custom_liquid_XriWzg","header","custom_liquid_Y3aKFr"]}