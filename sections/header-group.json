{"name":"t:sections.header.name","type":"header","sections":{"custom_liquid_XriWzg":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"marquee-wrapper\">\n  <div class=\"marquee-content\">\n    <div class=\"marquee-group\">\n      <span>ENVÍO GRATUITO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>✨ 33% DE DESCUENTO POR TIEMPO LIMITADO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>ENVÍO GRATUITO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>✨ 33% DE DESCUENTO POR TIEMPO LIMITADO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n    <\/div>\n    <div class=\"marquee-group\" aria-hidden=\"true\">\n      <span>ENVÍO GRATUITO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>✨ 33% DE DESCUENTO POR TIEMPO LIMITADO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>ENVÍO GRATUITO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n      <span>✨ 33% DE DESCUENTO POR TIEMPO LIMITADO<\/span>\n      <div class=\"marquee-dot\">•<\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n\/* Contenedor principal ajustado al color oliva de la marca *\/\n.marquee-wrapper {\n  \/* Usamos el verde oliva oscuro para que el texto blanco resalte con elegancia *\/\n  background-color: #121220; \n  color: #ffffff;\n  overflow: hidden;\n  padding: 10px 0; \/* Un poco más fino para que sea más elegante *\/\n  display: flex;\n  width: 100%;\n  \/* Sutil borde superior para separar de otras secciones *\/\n  border-top: 1px solid rgba(255,255,255,0.1);\n}\n\n\/* El bloque que se mueve *\/\n.marquee-content {\n  display: flex;\n  width: max-content;\n  animation: scroll-move 25s linear infinite; \/* Un poco más lento para facilitar la lectura *\/\n  will-change: transform;\n}\n\n\/* Configuración de los grupos de texto *\/\n.marquee-group {\n  display: flex;\n  align-items: center;\n  gap: 50px; \/* Un poco más de aire entre frases *\/\n  padding-right: 50px;\n}\n\n.marquee-group span {\n  font-weight: 700;\n  font-family: inherit;\n  font-size: 13px; \/* Tamaño profesional *\/\n  white-space: nowrap;\n  letter-spacing: 0.5px;\n}\n\n.marquee-dot {\n  font-size: 18px;\n  font-weight: bold;\n  \/* El punto en un tono más claro para dar dinamismo *\/\n  color: #f5c6d0; \n}\n\n\/* DEFINICIÓN DEL MOVIMIENTO *\/\n@keyframes scroll-move {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n\/* Pausar al pasar el ratón para que el cliente pueda leer si quiere *\/\n.marquee-wrapper:hover .marquee-content {\n  animation-play-state: paused;\n}\n<\/style>","color_scheme":"scheme-2","padding_top":0,"padding_bottom":0}},"header":{"type":"header","disabled":true,"settings":{"logo_position":"top-center","mobile_logo_position":"center","menu":"main-menu","menu_type_desktop":"dropdown","sticky_header_type":"on-scroll-up","show_line_separator":false,"color_scheme":"scheme-3","menu_color_scheme":"scheme-3","enable_country_selector":true,"enable_language_selector":true,"enable_customer_avatar":false,"margin_bottom":0,"padding_top":20,"padding_bottom":20}},"custom_liquid_Y3aKFr":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<header class=\"alx-header\" id=\"alx-header\">\n  <div class=\"alx-header__main\">\n    <div class=\"alx-container alx-header__inner\">\n      <button class=\"alx-burger\" type=\"button\" aria-label=\"Abrir menú\" aria-expanded=\"false\" aria-controls=\"alx-mobile-drawer\">\n        <span><\/span>\n        <span><\/span>\n        <span><\/span>\n      <\/button>\n\n      <nav class=\"alx-nav alx-nav--left\" aria-label=\"Menú principal izquierdo\">\n        <ul class=\"alx-nav__list\" role=\"list\">\n          <li><a href=\"\/\" class=\"alx-nav__link\">Página de Inicio<\/a><\/li>\n          <li><a href=\"\/products\/aliviax-pro\" class=\"alx-nav__link is-active\">AliviaX Pro<\/a><\/li>\n        <\/ul>\n      <\/nav>\n\n  