{"name":"t:sections.footer.name","type":"footer","sections":{"custom_liquid_mxppDL":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"ax-vip-ultimate-section\">\n  <div class=\"ax-ultimate-container ax-animate-scroll\">\n    \n    <div class=\"ax-u-content\">\n      <div class=\"ax-u-badge ax-reveal-item\">✦ ÚNETE AL MOVIMIENTO ALIVIAX<\/div>\n      <h2 class=\"ax-u-h2 ax-reveal-item\">No solo es una compra. <br><span class=\"ax-u-olive\">Es tu nueva postura.<\/span><\/h2>\n      <p class=\"ax-u-p ax-reveal-item\">El 80% de los problemas cervicales empeoran por falta de guía. No seas un número más en el carrito; únete y conviértete en nuestra prioridad absoluta. Tu bienestar real empieza aquí.<\/p>\n      \n      <div class=\"ax-u-perks\">\n        <div class=\"ax-u-item ax-reveal-item\">\n          <div class=\"ax-u-pulse-icon\">🔥<\/div>\n          <div class=\"ax-u-text\">\n            <strong>ACCESO ANTICIPADO TOTAL<\/strong>\n            <span>Compra antes que el resto y asegura tu unidad frente al stock limitado.<\/span>\n          <\/div>\n        <\/div>\n        <div class=\"ax-u-item ax-reveal-item\">\n          <div class=\"ax-u-pulse-icon\">📍<\/div>\n          <div class=\"ax-u-text\">\n            <strong>GUÍA DE REHABILITACIÓN<\/strong>\n            <span>Recibe al instante nuestra rutina de 5 minutos para liberar tensión.<\/span>\n          <\/div>\n        <\/div>\n        <div class=\"ax-u-item ax-reveal-item\">\n          <div class=\"ax-u-pulse-icon\">💎<\/div>\n          <div class=\"ax-u-text\">\n            <strong>BENEFICIOS POR LEALTAD<\/strong>\n            <span>Descuentos exclusivos y sorpresas reservadas solo para miembros activos.<\/span>\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"ax-u-form-side ax-reveal-card\">\n      <div class=\"ax-u-card\">\n        <h3 class=\"ax-u-card-h3\">Asegura tu lugar VIP<\/h3>\n        <p class=\"ax-u-card-p\">Únete a más de 5.000 socios hoy.<\/p>\n        \n        {% form 'customer', id: 'AxUltimateVipForm' %}\n          {% if form.posted_successfully? %}\n            <div class=\"ax-u-success\">\n              <p>✅ <strong>¡Bienvenido a la élite!<\/strong><br>Tu guía de salud ya está en camino a tu email.<\/p>\n            <\/div>\n          {% else %}\n            {{ form.errors | default_errors }}\n            <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter, socio_vip_prioridad\">\n            \n            <div class=\"ax-u-input-group\">\n              <label class=\"ax-u-label\">TU EMAIL PRINCIPAL<\/label>\n              <input type=\"email\" \n                     name=\"contact[email]\" \n                     placeholder=\"nombre@ejemplo.com\" \n                     required \n                     class=\"ax-u-input\">\n              \n              <button type=\"submit\" class=\"ax-u-btn\">\n                <span>QUIERO MI ACCESO PRIORITARIO<\/span>\n              <\/button>\n            <\/div>\n          {% endif %}\n        {% endform %}\n        \n        <div class=\"ax-u-trust-footer\">\n          <span>🛡️ Datos protegidos<\/span>\n          <span>•<\/span>\n          <span>Baja con un clic<\/span>\n        <\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/div>\n\n<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap');\n\n\/* --- BASE --- *\/\n.ax-vip-ultimate-section {\n  padding: 100px 20px;\n  background-color: #1a1c15;\n  font-family: 'Plus Jakarta Sans', sans-serif;\n  display: flex;\n  justify-content: center;\n  overflow: hidden;\n}\n\n.ax-ultimate-container {\n  max-width: 1100px;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 60px;\n}\n\n\/* --- LOGICA DE ANIMACIÓN (Modern CSS) --- *\/\n@supports (animation-timeline: view()) {\n  .ax-reveal-item {\n    animation: axFadeInUp both;\n    animation-timeline: view();\n    animation-range: entry 10% cover 30%;\n  }\n\n  .ax-reveal-card {\n    animation: axSlideInRight both;\n    animation-timeline: view();\n    animation-range: entry 10% cover 40%;\n  }\n\n  \/* Delay manual para los items del listado *\/\n  .ax-u-perks .ax-u-item:nth-child(2) { animation-delay: 0.1s; }\n  .ax-u-perks .ax-u-item:nth-child(3) { animation-delay: 0.2s; }\n}\n\n\/* Fallback para navegadores antiguos (se ve sin animación pero perfecto) *\/\n@keyframes axFadeInUp {\n  from { opacity: 0; transform: translateY(50px) scale(0.95); filter: blur(10px); }\n  to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }\n}\n\n@keyframes axSlideInRight {\n  from { opacity: 0; transform: translateX(80px) rotate(3deg); }\n  to { opacity: 1; transform: translateX(0) rotate(0deg); }\n}\n\n\/* --- ESTILOS DE ELEMENTOS --- *\/\n.ax-u-content { flex: 1.2; }\n.ax-u-badge { color: #6d7a48; font-weight: 800; font-size: 11px; letter-spacing: 2.5px; margin-bottom: 20px; }\n.ax-u-h2 { font-size: 42px; color: #fff; font-weight: 800; margin: 0 0 20px 0; line-height: 1.1; letter-spacing: -2px; }\n.ax-u-olive { color: #6d7a48; }\n.ax-u-p { color: #d1d1d1; font-size: 17px; line-height: 1.6; margin-bottom: 35px; }\n\n.ax-u-perks { display: grid; gap: 25px; }\n.ax-u-item { display: flex; align-items: flex-start; gap: 18px; transition: transform 0.3s ease; }\n.ax-u-item:hover { transform: translateX(10px); }\n\n.ax-u-pulse-icon {\n  font-size: 24px;\n  background: rgba(109, 122, 72, 0.15);\n  padding: 10px;\n  border-radius: 12px;\n  position: relative;\n}\n.ax-u-pulse-icon::after {\n  content: '';\n  position: absolute;\n  width: 100%; height: 100%;\n  top: 0; left: 0;\n  border-radius: 12px;\n  border: 1px solid #6d7a48;\n  animation: ax-pulse 2s infinite;\n}\n\n@keyframes ax-pulse {\n  0% { transform: scale(1); opacity: 1; }\n  100% { transform: scale(1.5); opacity: 0; }\n}\n\n.ax-u-text strong { display: block; color: #fff; font-size: 15px; margin-bottom: 4px; letter-spacing: 0.5px; }\n.ax-u-text span { color: #999; font-size: 14px; line-height: 1.4; }\n\n.ax-u-form-side { flex: 0.8; }\n.ax-u-card {\n  background: #ffffff;\n  padding: 45px 35px;\n  border-radius: 32px;\n  box-shadow: 0 30px 70px rgba(0,0,0,0.4);\n  border: 1px solid rgba(255,255,255,0.1);\n}\n\n.ax-u-card-h3 { color: #111; font-size: 26px; font-weight: 800; margin: 0 0 10px 0; text-align: center; }\n.ax-u-card-p { color: #666; font-size: 14px; text-align: center; margin-bottom: 30px; font-weight: 600; }\n\n.ax-u-label { display: block; font-size: 11px; font-weight: 800; color: #6d7a48; margin-bottom: 10px; letter-spacing: 1px; }\n.ax-u-input {\n  width: 100%;\n  padding: 18px 20px !important;\n  background: #f4f5f1 !important;\n  border: 2px solid #e1e3da !important;\n  border-radius: 16px !important;\n  font-size: 16px !important;\n  color: #111 !important;\n  margin-bottom: 15px !important;\n  outline: none !important;\n  transition: all 0.3s;\n}\n.ax-u-input:focus { border-color: #6d7a48 !important; background: #fff !important; }\n\n.ax-u-btn {\n  width: 100%;\n  background: #111;\n  color: white;\n  padding: 20px;\n  border: none;\n  border-radius: 16px;\n  font-weight: 800;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.4s;\n  letter-spacing: 0.5px;\n}\n.ax-u-btn:hover { background: #6d7a48; transform: translateY(-3px); box-shadow: 0 15px 30px rgba(109,122,72,0.3); }\n\n.ax-u-trust-footer { display: flex; justify-content: center; gap: 10px; font-size: 11px; color: #999; margin-top: 20px; font-weight: 600; }\n.ax-u-success { text-align: center; background: #f0f4e8; padding: 20px; border-radius: 16px; color: #4a5431; }\n\n@media (max-width: 900px) {\n  .ax-ultimate-container { flex-direction: column; text-align: center; gap: 40px; }\n  .ax-u-h2 { font-size: 34px; }\n  .ax-u-item { text-align: left; }\n  .ax-u-card { padding: 35px 20px; }\n  \n  \/* Desactivamos animaciones complejas en móvil para fluidez total *\/\n  .ax-reveal-card { animation: axFadeInUp both; }\n}\n<\/style>","color_scheme":"scheme-1","padding_top":0,"padding_bottom":0}},"custom_liquid_hH3Utx":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .ax-footer-final {\n    background-color: #ffffff;\n    padding: 60px 20px 30px 20px;\n    font-family: 'Assistant', sans-serif;\n    border-top: 1px solid #f0f0f0;\n  }\n\n  .ax-wrapper-final {\n    max-width: 1150px;\n    margin: 0 auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 30px;\n  }\n\n  \/* --- Marca --- *\/\n  .ax-col-brand { flex: 1.2; }\n  .ax-brand-name { font-size: 24px; font-weight: 800; color: #1a233a; margin-bottom: 12px; display: block; }\n  .ax-brand-text { font-size: 13px; color: #666; line-height: 1.5; margin-bottom: 15px; display: block; }\n  .ax-stars { color: #768a5d; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 5px; }\n\n  \/* --- Recuadros Soporte y Legal --- *\/\n  .ax-col-box {\n    flex: 1;\n    background: #f9f9f9; \n    padding: 20px;\n    border-radius: 18px; \n    border: 1px solid #eeeeee;\n    transition: all 0.3s ease;\n  }\n\n  .ax-col-box:hover {\n    border-color: #768a5d;\n    background: #ffffff;\n    box-shadow: 0 10px 20px rgba(0,0,0,0.03);\n  }\n\n  .ax-title-mini {\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1.2px;\n    color: #768a5d;\n    margin-bottom: 15px;\n    display: block;\n  }\n\n  .ax-links-final { list-style: none; padding: 0; margin: 0; }\n  .ax-links-final li { margin-bottom: 10px; }\n  .ax-links-final a { text-decoration: none; color: #1a233a; font-size: 14px; font-weight: 500; }\n  .ax-links-final a:hover { color: #768a5d; }\n\n  \/* --- Columna Trust (Derecha) --- *\/\n  .ax-col-trust { flex: 1.2; display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }\n  .ax-trust-tag { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; color: #1a233a; }\n  .ax-trust-tag svg { width: 16px; fill: #768a5d; opacity: 0.8; }\n\n  \/* --- Barra de Pagos --- *\/\n  .ax-payments-strip {\n    max-width: 1150px;\n    margin: 40px auto 20px;\n    text-align: center;\n    padding-top: 25px;\n    border-top: 1px solid #f5f5f5;\n  }\n\n  .ax-payments-img {\n    max-width: 550px;\n    width: 100%;\n    height: auto;\n  }\n\n  .ax-copyright { font-size: 11px; color: #bbb; text-align: center; margin-top: 10px; }\n\n  @media (max-width: 850px) {\n    .ax-wrapper-final { flex-direction: column; text-align: center; }\n    .ax-col-brand, .ax-col-box, .ax-col-trust { width: 100%; flex: none; }\n    .ax-stars { justify-content: center; }\n    .ax-col-trust { margin-top: 10px; }\n  }\n<\/style>\n\n<div class=\"ax-footer-final\">\n  <div class=\"ax-wrapper-final\">\n    \n    <div class=\"ax-col-brand\">\n      <span class=\"ax-brand-name\">AliviaX<\/span>\n      <span class=\"ax-brand-text\">Contamos con +1000 clientes satisfechos con su salud tras confiar en nosotros.<\/span>\n      <div class=\"ax-stars\"><span>★<\/span> Contribuyendo a tu bienestar diario<\/div>\n    <\/div>\n\n    <div class=\"ax-col-box\">\n      <span class=\"ax-title-mini\">Soporte<\/span>\n      <ul class=\"ax-links-final\">\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/contact\">Contacto<\/a><\/li>\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/quienes-somos\">Quiénes Somos<\/a><\/li>\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/politica-de-envios\">Seguimiento de Envío<\/a><\/li>\n      <\/ul>\n    <\/div>\n\n    <div class=\"ax-col-box\">\n      <span class=\"ax-title-mini\">Legal<\/span>\n      <ul class=\"ax-links-final\">\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/politica-de-privacidad\">Privacidad<\/a><\/li>\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/terminos-y-condiciones\">Términos<\/a><\/li>\n        <li><a href=\"https:\/\/ukytjt-kx.myshopify.com\/pages\/politica-de-devoluciones-y-reembolsos\">Devoluciones<\/a><\/li>\n      <\/ul>\n    <\/div>\n\n    <div class=\"ax-col-trust\">\n      <div class=\"ax-trust-tag\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z\"\/><\/svg>PAGO SSL<\/div>\n      <div class=\"ax-trust-tag\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z\"\/><\/svg>ENVÍO GRATIS<\/div>\n      <div class=\"ax-trust-tag\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"\/><\/svg>AYUDA 24\/7<\/div>\n      <div class=\"ax-trust-tag\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"\/><\/svg>14 DÍAS DE GARANTÍA<\/div>\n    <\/div>\n\n  <\/div>\n\n  <div class=\"ax-payments-strip\">\n    <img src=\"https:\/\/cdn.discordapp.com\/attachments\/1029763307478974464\/1491110602956083401\/image.png?ex=69d68077&is=69d52ef7&hm=40b942024c3a5fe8e97346bedee02752fc795bebd40b6baf03c24f8f62ee6035&\" class=\"ax-payments-img\" alt=\"Métodos de pago\">\n    <div class=\"ax-copyright\">© 2026 AliviaX. Tu bienestar, nuestra prioridad.<\/div>\n  <\/div>\n<\/div>","color_scheme":"scheme-1","padding_top":0,"padding_bottom":0}},"footer":{"type":"footer","blocks":{"link_list_U7M6hF":{"type":"link_list","settings":{"heading":"Información Legal y Política","menu":"footer-1"}}},"block_order":["link_list_U7M6hF"],"disabled":true,"settings":{"color_scheme":"scheme-3","newsletter_enable":false,"newsletter_heading":"Subscribe to our emails","enable_follow_on_shop":false,"show_social":false,"enable_country_selector":false,"enable_language_selector":false,"payment_enable":true,"show_policy":false,"margin_top":0,"padding_top":44,"padding_bottom":60}}},"order":["custom_liquid_mxppDL","custom_liquid_hH3Utx","footer"]}