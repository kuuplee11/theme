{% comment %} AliviaX — Página de Producto {% endcomment %}

<style>
/* ═══════════════════════════════════════════════════════════════
   BASE
═══════════════════════════════════════════════════════════════ */
.aop {
  --white:    #ffffff;
  --cream:    #f8f5f1;
  --deep:     #121220;
  --navy:     #1e1e30;
  --rose:     #c25a70;
  --rose-d:   #a84860;
  --rose-l:   #f5c6d0;
  --blush:    #fdeef1;
  --gold:     #b8925a;
  --muted:    #7a7a8c;
  --border:   #e6e0ec;
  --green:    #2da87a;
  --r-s:      10px;
  --r-m:      18px;
  --r-l:      28px;
  --sh-s:     0 2px 12px rgba(18,18,32,.07);
  --sh-m:     0 8px 32px rgba(18,18,32,.10);
  --sh-l:     0 20px 56px rgba(18,18,32,.13);
  --t:        .22s ease;
  color: var(--deep);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
}
.aop *, .aop *::before, .aop *::after { box-sizing: border-box; }
.aop a { text-decoration: none; color: inherit; }
.aop img { display: block; max-width: 100%; }
.aop p { margin: 0; }

.aop .wrap  { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.aop .wrap-s{ max-width: 860px;  margin: 0 auto; padding: 0 24px; }

/* ═══════════════════════════════════════════════════════════════
   BREADCRUMB
═══════════════════════════════════════════════════════════════ */
.aop__crumb {
  background: var(--cream); border-bottom: 1px solid var(--border);
  padding: 14px 24px;
}
.aop__crumb-inner {
  max-width: 1200px; margin: 0 auto;
  display: flex; align-items: center; gap: 8px;
  font-size: 13px; color: var(--muted);
}
.aop__crumb a { color: var(--muted); transition: color var(--t); }
.aop__crumb a:hover { color: var(--rose); }
.aop__crumb .sep { opacity: .5; }
.aop__crumb .current { color: var(--deep); font-weight: 600; }

/* ═══════════════════════════════════════════════════════════════
   HERO PRODUCTO — GRID
═══════════════════════════════════════════════════════════════ */
.aop__main { background: var(--white); padding: 48px 24px 80px; }
.aop__grid {
  max-width: 1200px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 64px; align-items: start;
}

/* — Galería — */
.aop__gallery { position: sticky; top: 100px; }
.aop__main-img {
  width: 100%; aspect-ratio: 1; border-radius: var(--r-l); overflow: hidden;
  background: linear-gradient(145deg, #fce6ec, #f9f0f4, #ede9f5);
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-l); position: relative; cursor: zoom-in;
  margin-bottom: 14px;
}
.aop__main-img img {
  width: 92%; height: 92%; object-fit: contain;
  transition: transform .35s ease;
}
.aop__main-img:hover img { transform: scale(1.05); }
.aop__main-img .ph {
  font-size: 80px; line-height: 1;
  opacity: .4;
}
.aop__img-badge {
  position: absolute; top: 16px; left: 16px; z-index: 2;
  height: 28px; padding: 0 12px; border-radius: 999px;
  background: var(--rose); color: #fff; font-size: 12px; font-weight: 800;
}
.aop__thumbs {
  display: flex; gap: 10px; flex-wrap: wrap;
}
.aop__thumb {
  width: 72px; height: 72px; border-radius: var(--r-s); overflow: hidden;
  border: 2px solid var(--border); cursor: pointer;
  transition: border-color var(--t), box-shadow var(--t);
  background: var(--cream); display: flex; align-items: center; justify-content: center;
}
.aop__thumb:hover { border-color: var(--rose); }
.aop__thumb.active { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(194,90,112,.15); }
.aop__thumb img { width: 100%; height: 100%; object-fit: cover; }
.aop__thumb .ph-t { font-size: 26px; opacity: .5; }

/* — Info panel — */
.aop__info { padding-top: 4px; }

.aop__badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.aop__badge {
  height: 24px; padding: 0 10px; border-radius: 999px;
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;
  display: inline-flex; align-items: center;
}
.aop__badge.bestseller { background: rgba(194,90,112,.1); color: var(--rose-d); }
.aop__badge.new        { background: rgba(45,168,122,.1); color: var(--green); }
.aop__badge.limited    { background: rgba(184,146,90,.1); color: var(--gold); }

.aop__stars {
  display: flex; align-items: center; gap: 10px; margin-bottom: 18px;
}
.aop__stars .stars { color: #d4a54a; font-size: 18px; letter-spacing: 1px; }
.aop__stars a { color: var(--muted); font-size: 13px; font-weight: 600; text-decoration: underline; text-decoration-color: rgba(122,122,140,.4); }

.aop__title {
  font-size: clamp(28px, 3.2vw, 42px); font-weight: 900; letter-spacing: -.05em;
  line-height: 1.02; margin: 0 0 8px;
}
.aop__subtitle {
  color: var(--muted); font-size: 15px; line-height: 1.6; margin-bottom: 24px;
}

/* precio */
.aop__price-row {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  padding: 20px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  margin-bottom: 24px;
}
.aop__price-cur {
  font-size: 40px; font-weight: 900; letter-spacing: -.05em; line-height: 1; color: var(--deep);
}
.aop__price-old {
  font-size: 20px; font-weight: 600; color: #bbb; text-decoration: line-through; line-height: 1;
}
.aop__price-save {
  height: 28px; padding: 0 12px; border-radius: 999px;
  background: var(--rose); color: #fff; font-size: 13px; font-weight: 800;
  display: inline-flex; align-items: center;
}
.aop__price-note { width: 100%; font-size: 12px; color: var(--muted); }

/* beneficios rápidos */
.aop__quick-benefits {
  display: grid; gap: 10px; margin-bottom: 28px;
}
.aop__qb {
  display: flex; align-items: center; gap: 10px;
  font-size: 14px; font-weight: 600; color: var(--deep);
}
.aop__qb-icon { font-size: 18px; flex-shrink: 0; line-height: 1; }
.aop__qb span { color: var(--muted); font-size: 13px; }

/* add to cart */
.aop__form {}
.aop__qty-row {
  display: flex; align-items: center; gap: 14px; margin-bottom: 14px;
}
.aop__qty-label { font-size: 13px; font-weight: 700; color: var(--muted); }
.aop__qty-ctrl {
  display: flex; align-items: center;
  border: 1px solid var(--border); border-radius: 999px; overflow: hidden;
}
.aop__qty-btn {
  width: 38px; height: 38px; background: none; border: none;
  cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;
  color: var(--deep); transition: background var(--t);
}
.aop__qty-btn:hover { background: var(--cream); }
.aop__qty-input {
  width: 44px; text-align: center; border: none; background: none;
  font-size: 15px; font-weight: 800; color: var(--deep); outline: none;
  -moz-appearance: textfield;
}
.aop__qty-input::-webkit-outer-spin-button,
.aop__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; }

.aop__add-btn {
  width: 100%; height: 58px; border-radius: 999px;
  background: var(--rose); color: #fff; border: none; cursor: pointer;
  font-size: 15px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  box-shadow: 0 10px 30px rgba(194,90,112,.35);
  transition: all var(--t); animation: aop-breath 2.8s ease-in-out infinite;
  margin-bottom: 12px;
}
.aop__add-btn:hover:not(:disabled) { background: var(--rose-d); transform: translateY(-2px); box-shadow: 0 16px 38px rgba(194,90,112,.45); }
.aop__add-btn:disabled { background: #ccc; box-shadow: none; animation: none; cursor: not-allowed; }
.aop__add-btn .btn-icon { font-size: 20px; }

.aop__buy-now {
  width: 100%; height: 52px; border-radius: 999px;
  background: var(--deep); color: #fff; border: none; cursor: pointer;
  font-size: 14px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-m); transition: all var(--t); margin-bottom: 20px;
  text-decoration: none;
}
.aop__buy-now:hover { background: var(--navy); transform: translateY(-1px); }

@keyframes aop-breath {
  0%,100% { box-shadow: 0 10px 28px rgba(194,90,112,.32); }
  50%      { box-shadow: 0 16px 40px rgba(194,90,112,.52); }
}

/* trust mini */
.aop__trust-mini {
  display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 24px;
}
.aop__tmini {
  background: var(--cream); border: 1px solid var(--border);
  border-radius: var(--r-s); padding: 12px 14px; text-align: center;
}
.aop__tmini .ti { font-size: 20px; display: block; margin-bottom: 4px; }
.aop__tmini strong { display: block; font-size: 12px; font-weight: 800; color: var(--deep); }
.aop__tmini span { font-size: 11px; color: var(--muted); }

/* acordeón detalles */
.aop__accordion { border-top: 1px solid var(--border); }
.aop__ac-item { border-bottom: 1px solid var(--border); }
.aop__ac-q {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 0; cursor: pointer; user-select: none; gap: 12px;
}
.aop__ac-q span { font-size: 14px; font-weight: 700; color: var(--deep); }
.aop__ac-arrow { color: var(--rose); font-size: 13px; transition: transform var(--t); flex-shrink: 0; }
.aop__ac-item.open .aop__ac-arrow { transform: rotate(180deg); }
.aop__ac-body { display: none; padding-bottom: 16px; }
.aop__ac-item.open .aop__ac-body { display: block; }
.aop__ac-body p { color: var(--muted); font-size: 14px; line-height: 1.72; }
.aop__ac-body ul { margin: 0; padding-left: 18px; }
.aop__ac-body ul li { color: var(--muted); font-size: 14px; line-height: 1.72; margin-bottom: 4px; }

/* ═══════════════════════════════════════════════════════════════
   BENEFICIOS DETALLADOS
═══════════════════════════════════════════════════════════════ */
.aop__benefits { background: var(--cream); padding: 88px 24px; }
.aop__benefits-head { text-align: center; max-width: 600px; margin: 0 auto 52px; }
.aop__benefits-head .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; }
.aop__benefits-head .eyebrow::before { content: ""; width: 22px; height: 2px; background: currentColor; }
.aop__benefits-head h2 { font-size: clamp(28px, 3.5vw, 46px); font-weight: 800; letter-spacing: -.04em; line-height: 1.05; margin: 0; }
.aop__benefits-head h2 em { font-style: italic; font-weight: 300; color: var(--rose); }
.aop__benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.aop__benefit-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--r-l); padding: 36px 30px;
  transition: box-shadow var(--t), transform var(--t);
}
.aop__benefit-card:hover { box-shadow: var(--sh-m); transform: translateY(-3px); }
.aop__bc-icon {
  width: 60px; height: 60px; border-radius: var(--r-m);
  background: var(--blush); display: flex; align-items: center; justify-content: center;
  font-size: 26px; margin-bottom: 20px;
}
.aop__bc-num {
  font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
  color: var(--rose); margin-bottom: 10px;
}
.aop__bc-title { font-size: 20px; font-weight: 800; letter-spacing: -.03em; color: var(--deep); margin: 0 0 12px; }
.aop__bc-text { color: var(--muted); font-size: 15px; line-height: 1.72; }

/* ═══════════════════════════════════════════════════════════════
   TIMELINE RESULTADOS
═══════════════════════════════════════════════════════════════ */
.aop__timeline { background: var(--white); padding: 88px 24px; }
.aop__timeline-head { text-align: center; max-width: 580px; margin: 0 auto 52px; }
.aop__timeline-head .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; }
.aop__timeline-head .eyebrow::before { content: ""; width: 22px; height: 2px; background: currentColor; }
.aop__timeline-head h2 { font-size: clamp(28px, 3.5vw, 46px); font-weight: 800; letter-spacing: -.04em; line-height: 1.05; margin: 0; }
.aop__timeline-head h2 em { font-style: italic; font-weight: 300; color: var(--rose); }

.aop__weeks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.aop__wcard {
  background: var(--cream); border: 1px solid var(--border);
  border-radius: var(--r-l); padding: 32px 28px; position: relative;
  overflow: hidden; transition: box-shadow var(--t);
}
.aop__wcard:hover { box-shadow: var(--sh-m); }
.aop__wcard::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px;
}
.aop__wcard:nth-child(1)::before { background: var(--rose-l); }
.aop__wcard:nth-child(2)::before { background: var(--rose); }
.aop__wcard:nth-child(3)::before { background: var(--deep); }
.aop__wcard-emoji { font-size: 36px; margin-bottom: 16px; display: block; line-height: 1; }
.aop__wcard-tag {
  display: inline-flex; align-items: center;
  height: 22px; padding: 0 10px; border-radius: 999px;
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .09em;
  margin-bottom: 12px;
}
.aop__wcard:nth-child(1) .aop__wcard-tag { background: rgba(194,90,112,.1); color: var(--rose-d); }
.aop__wcard:nth-child(2) .aop__wcard-tag { background: var(--rose); color: #fff; }
.aop__wcard:nth-child(3) .aop__wcard-tag { background: var(--deep); color: #fff; }
.aop__wcard h3 { font-size: 20px; font-weight: 800; letter-spacing: -.03em; color: var(--deep); margin: 0 0 10px; }
.aop__wcard p  { color: var(--muted); font-size: 14px; line-height: 1.7; }

/* ═══════════════════════════════════════════════════════════════
   CÓMO USAR
═══════════════════════════════════════════════════════════════ */
.aop__how { background: var(--deep); padding: 88px 24px; position: relative; overflow: hidden; }
.aop__how::before {
  content: ""; pointer-events: none;
  position: absolute; top: -80px; right: -80px;
  width: 420px; height: 420px; border-radius: 50%;
  background: radial-gradient(circle, rgba(194,90,112,.15), transparent 65%);
}
.aop__how-head { text-align: center; max-width: 560px; margin: 0 auto 52px; position: relative; z-index: 1; }
.aop__how-head .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--rose-l); margin-bottom: 14px; }
.aop__how-head .eyebrow::before { content: ""; width: 22px; height: 2px; background: currentColor; }
.aop__how-head h2 { font-size: clamp(28px, 3.5vw, 46px); font-weight: 800; letter-spacing: -.04em; line-height: 1.05; color: #fff; margin: 0; }
.aop__how-head h2 em { font-style: italic; font-weight: 300; color: var(--rose-l); }
.aop__steps-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; position: relative; z-index: 1; }
.aop__step {
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09);
  border-radius: var(--r-m); padding: 26px 16px; text-align: center; transition: background var(--t);
}
.aop__step:hover { background: rgba(255,255,255,.09); }
.aop__step-ico {
  width: 54px; height: 54px; border-radius: 50%;
  background: rgba(194,90,112,.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; margin: 0 auto 14px;
}
.aop__step-n { color: var(--rose-l); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 8px; }
.aop__step h4 { color: #fff; font-size: 14px; font-weight: 800; margin: 0 0 8px; }
.aop__step p  { color: rgba(255,255,255,.6); font-size: 12px; line-height: 1.6; }

/* ═══════════════════════════════════════════════════════════════
   REVIEWS
═══════════════════════════════════════════════════════════════ */
.aop__reviews { background: var(--cream); padding: 88px 24px; }
.aop__reviews-head { text-align: center; max-width: 600px; margin: 0 auto 14px; }
.aop__reviews-head .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; }
.aop__reviews-head .eyebrow::before { content: ""; width: 22px; height: 2px; background: currentColor; }
.aop__reviews-head h2 { font-size: clamp(28px, 3.5vw, 46px); font-weight: 800; letter-spacing: -.04em; line-height: 1.05; margin: 0; }
.aop__reviews-head h2 em { font-style: italic; font-weight: 300; color: var(--rose); }
.aop__reviews-summary {
  display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 48px;
}
.aop__reviews-summary .big-stars { color: #d4a54a; font-size: 24px; letter-spacing: 2px; }
.aop__reviews-summary .big-rating { font-size: 40px; font-weight: 900; letter-spacing: -.05em; line-height: 1; }
.aop__reviews-summary .rcount { color: var(--muted); font-size: 14px; font-weight: 600; }
.aop__reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.aop__rcard {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--r-m); padding: 28px 26px;
  transition: box-shadow var(--t), transform var(--t);
}
.aop__rcard:hover { box-shadow: var(--sh-m); transform: translateY(-2px); }
.aop__rcard.featured { border-color: var(--rose-l); background: var(--blush); }
.aop__rcard .verified {
  display: inline-flex; align-items: center; gap: 5px;
  height: 22px; padding: 0 10px; border-radius: 999px;
  background: rgba(45,168,122,.1); color: var(--green);
  font-size: 11px; font-weight: 700; margin-bottom: 12px;
}
.aop__rcard .rstars { color: #d4a54a; font-size: 14px; margin-bottom: 8px; }
.aop__rcard .rweek {
  display: inline-flex; height: 22px; padding: 0 10px; border-radius: 8px;
  background: var(--cream); border: 1px solid var(--border);
  font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 12px;
  align-items: center; gap: 4px;
}
.aop__rcard blockquote { margin: 0 0 18px; font-size: 14px; line-height: 1.7; color: var(--deep); font-style: italic; }
.aop__rcard-author { display: flex; align-items: center; gap: 10px; }
.aop__rcard .avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: linear-gradient(135deg, var(--rose-l), var(--rose));
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 900; color: #fff; flex-shrink: 0;
}
.aop__rcard .rname { font-size: 13px; font-weight: 800; color: var(--deep); }
.aop__rcard .rmeta { font-size: 12px; color: var(--muted); }

/* ═══════════════════════════════════════════════════════════════
   FAQ MINI
═══════════════════════════════════════════════════════════════ */
.aop__faq { background: var(--white); padding: 88px 24px; }
.aop__faq-head { text-align: center; max-width: 560px; margin: 0 auto 44px; }
.aop__faq-head .eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; }
.aop__faq-head .eyebrow::before { content: ""; width: 22px; height: 2px; background: currentColor; }
.aop__faq-head h2 { font-size: clamp(26px, 3vw, 40px); font-weight: 800; letter-spacing: -.04em; line-height: 1.05; margin: 0; }
.aop__faq-list { display: grid; gap: 8px; }
.aop__faq-item {
  background: var(--cream); border: 1px solid var(--border);
  border-radius: var(--r-m); overflow: hidden; transition: border-color var(--t);
}
.aop__faq-item.open { border-color: var(--rose-l); }
.aop__faq-q {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18px 22px; cursor: pointer; user-select: none; gap: 12px;
}
.aop__faq-q h3 { margin: 0; font-size: 15px; font-weight: 700; color: var(--deep); line-height: 1.4; }
.aop__faq-arr {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
  background: var(--white); border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  color: var(--rose); font-size: 12px; transition: transform var(--t);
}
.aop__faq-item.open .aop__faq-arr { transform: rotate(180deg); }
.aop__faq-a { display: none; padding: 0 22px 18px; }
.aop__faq-item.open .aop__faq-a { display: block; }
.aop__faq-a p { color: var(--muted); font-size: 14px; line-height: 1.72; }

/* ═══════════════════════════════════════════════════════════════
   CTA INFERIOR
═══════════════════════════════════════════════════════════════ */
.aop__cta-bottom { background: var(--deep); padding: 80px 24px; text-align: center; position: relative; overflow: hidden; }
.aop__cta-bottom::before {
  content: ""; pointer-events: none;
  position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
  width: 600px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(194,90,112,.2), transparent 65%);
}
.aop__cta-bottom .wrap { position: relative; z-index: 1; }
.aop__cta-bottom h2 { color: #fff; font-size: clamp(28px,4vw,50px); font-weight: 900; letter-spacing: -.05em; line-height: 1.04; margin: 0 0 14px; }
.aop__cta-bottom h2 em { font-style: italic; font-weight: 300; color: var(--rose-l); }
.aop__cta-bottom p { color: rgba(255,255,255,.68); font-size: 16px; line-height: 1.6; margin-bottom: 30px; }
.aop__cta-bottom-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px; }
.aop__cta-bottom .btn-rose {
  height: 58px; padding: 0 36px; border-radius: 999px;
  background: var(--rose); color: #fff; border: none; cursor: pointer;
  font-size: 15px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  box-shadow: 0 10px 30px rgba(194,90,112,.35);
  transition: all var(--t); text-decoration: none; display: inline-flex; align-items: center;
  animation: aop-breath 2.8s ease-in-out infinite;
}
.aop__cta-bottom .btn-rose:hover { background: var(--rose-d); transform: translateY(-2px); }
.aop__cta-bottom .trust-row {
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; margin-top: 22px;
}
.aop__cta-bottom .trust-row span { color: rgba(255,255,255,.65); font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 5px; }

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════════ */
@media (max-width: 990px) {
  .aop__grid        { grid-template-columns: 1fr; gap: 40px; }
  .aop__gallery     { position: static; }
  .aop__benefits-grid { grid-template-columns: 1fr 1fr; }
  .aop__weeks       { grid-template-columns: 1fr; }
  .aop__steps-grid  { grid-template-columns: repeat(3, 1fr); }
  .aop__reviews-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .aop__main        { padding: 32px 16px 60px; }
  .aop__title       { font-size: 28px; }
  .aop__trust-mini  { grid-template-columns: 1fr 1fr; }
  .aop__benefits-grid  { grid-template-columns: 1fr; }
  .aop__weeks       { grid-template-columns: 1fr; }
  .aop__steps-grid  { grid-template-columns: 1fr 1fr; }
  .aop__reviews-grid { grid-template-columns: 1fr; }
  .aop__benefits,
  .aop__timeline,
  .aop__how,
  .aop__reviews,
  .aop__faq,
  .aop__cta-bottom  { padding-top: 64px; padding-bottom: 64px; }
}
