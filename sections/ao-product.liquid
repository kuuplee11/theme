            <button type="submit" class="btn-rose">🛒 AÑADIR AL CARRITO</button>
          </form>
        {%- else -%}
          <a href="{{ section.settings.product_url | default: '/products/gafas-antiojeras-aliviax' }}" class="btn-rose">🛒 COMPRAR AHORA</a>
        {%- endif -%}
      </div>
      <div class="trust-row">
        <span>🛡️ 30 días sin riesgo</span>
        <span>🚚 Envío gratis</span>
        <span>🏆 Garantía 1 año</span>
        <span>🔒 Pago seguro</span>
      </div>
    </div>
  </section>

</div>

<script>
(function () {
  'use strict';

  /* ── Galería de imágenes ── */
  var display = document.getElementById('aop-img-display');
  document.querySelectorAll('.aop__thumb').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      document.querySelectorAll('.aop__thumb').forEach(function (t) { t.classList.remove('active'); });
      thumb.classList.add('active');
      if (display && thumb.dataset.src) {
        display.src = thumb.dataset.src;
        if (thumb.dataset.alt) display.alt = thumb.dataset.alt;
      }
    });
  });

  /* ── Cantidad ── */
  var qtyInput = document.getElementById('aop-qty');
  var minusBtn = document.getElementById('aop-qty-minus');
  var plusBtn  = document.getElementById('aop-qty-plus');
  if (qtyInput && minusBtn && plusBtn) {
    minusBtn.addEventListener('click', function () {
      var v = parseInt(qtyInput.value, 10) || 1;
      if (v > 1) qtyInput.value = v - 1;
    });
    plusBtn.addEventListener('click', function () {
      var v = parseInt(qtyInput.value, 10) || 1;
      if (v < 10) qtyInput.value = v + 1;
    });
  }

  /* ── Acordeón detalles ── */
  document.querySelectorAll('.aop__ac-item').forEach(function (item) {
    item.querySelector('.aop__ac-q').addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.aop__ac-item').forEach(function (i) { i.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

  /* ── FAQ ── */
  document.querySelectorAll('.aop__faq-item').forEach(function (item) {
    item.querySelector('.aop__faq-q').addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.aop__faq-item').forEach(function (i) { i.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

}());
</script>

{% schema %}
{
  "name": "AliviaX Producto",
  "settings": [
    { "type": "header", "content": "Imagen de respaldo" },
    { "type": "image_picker", "id": "product_image", "label": "Imagen del producto" },
    { "type": "header", "content": "Precios y enlace" },
    { "type": "url",  "id": "product_url",  "label": "URL del producto" },
    { "type": "text", "id": "price",      "label": "Precio actual",           "default": "49,99€" },
    { "type": "text", "id": "old_price",  "label": "Precio original (tachado)","default": "79,99€" },
    { "type": "text", "id": "badge_text", "label": "Badge de descuento",       "default": "-37%" }
  ],
  "presets": [{ "name": "AliviaX Producto" }]
}
{% endschema %}
