<script>
(function () {
  'use strict';

  /* sticky */
  var sticky = document.getElementById('ao-sticky');
  var heroBtn = document.querySelector('.ao__hero-actions');
  if (sticky && heroBtn) {
    window.addEventListener('scroll', function () {
      var show = heroBtn.getBoundingClientRect().bottom < 0;
      sticky.style.transform = show ? 'translateY(0)' : 'translateY(100%)';
      sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
    }, { passive: true });
  }

  /* scroll suave */
  var scrollBtn = document.querySelector('[data-scrollto]');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', function () {
      var target = document.querySelector(scrollBtn.getAttribute('data-scrollto'));
      if (!target) return;
      var y = target.getBoundingClientRect().top + window.pageYOffset - 20;
      if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) { window.scrollTo(0, y); return; }
      var s = window.pageYOffset, d = y - s, dur = 900, t0 = performance.now();
      function step(t) {
        var p = Math.min((t - t0) / dur, 1);
        var e = p < .5 ? 4*p*p*p : 1 - Math.pow(-2*p+2,3)/2;
        window.scrollTo(0, s + d * e);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }

  /* FAQ */
  document.querySelectorAll('.ao__faq-item').forEach(function (item) {
    item.querySelector('.ao__faq-q').addEventListener('click', function () {
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.ao__faq-item').forEach(function (f) { f.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

  /* countdown */
  var timer = document.getElementById('ao-timer');
  if (timer) {
    var dEl = timer.querySelector('[data-ao-d]');
    var hEl = timer.querySelector('[data-ao-h]');
    var mEl = timer.querySelector('[data-ao-m]');
    var deadline = new Date(Date.now() + 47 * 3600000);
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = deadline - Date.now();
      if (diff <= 0) { dEl.textContent = hEl.textContent = mEl.textContent = '00'; return; }
      dEl.textContent = pad(Math.floor(diff / 86400000));
      hEl.textContent = pad(Math.floor(diff / 3600000 % 24));
      mEl.textContent = pad(Math.floor(diff / 60000 % 60));
    }
    tick(); setInterval(tick, 1000);
  }
}());
</script>

