{% comment %} AliviaX Anti-Ojeras — Landing Page v3 {% endcomment %}

{%- liquid
  assign product_url = section.settings.product_url | default: '/products/gafas-antiojeras-aliviax'
  assign price       = section.settings.price       | default: '49,99€'
  assign old_price   = section.settings.old_price   | default: '79,99€'
  assign badge       = section.settings.badge_text  | default: '-37%'
-%}

<style>
/* ═══════════════════════════════════════════════════════════════
   BASE & VARIABLES
═══════════════════════════════════════════════════════════════ */
.ao {
  --white:    #ffffff;
  --cream:    #f8f5f1;
  --cream2:   #f2ede8;
  --deep:     #121220;
  --navy:     #1e1e30;
  --rose:     #c25a70;
  --rose-d:   #a84860;
  --rose-l:   #f5c6d0;
  --blush:    #fdeef1;
  --gold:     #b8925a;
  --muted:    #7a7a8c;
  --border:   #e6e0ec;
  --green:    #2da87a;
  --r-s:      12px;
  --r-m:      20px;
  --r-l:      32px;
  --sh-s:     0 2px 14px rgba(18,18,32,.07);
  --sh-m:     0 8px 32px rgba(18,18,32,.10);
  --sh-l:     0 20px 60px rgba(18,18,32,.13);
  --t:        .22s ease;
  color: var(--deep);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
}
.ao *, .ao *::before, .ao *::after { box-sizing: border-box; }
.ao a { text-decoration: none; color: inherit; }
.ao img { display: block; max-width: 100%; }
.ao p { margin: 0; }

.ao .wrap  { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.ao .wrap-s{ max-width: 820px;  margin: 0 auto; padding: 0 24px; }
.ao .wrap-xs{ max-width: 640px; margin: 0 auto; padding: 0 24px; }

.ao .eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 11px; font-weight: 800; letter-spacing: .22em;
  text-transform: uppercase; margin-bottom: 16px;
  color: var(--rose);
}
.ao .eyebrow::before {
  content: ""; display: block;
  width: 22px; height: 2px; background: currentColor;
}

.ao h2.ttl {
  margin: 0; line-height: 1.04; font-weight: 800; letter-spacing: -.04em;
  font-size: clamp(32px, 4.2vw, 58px);
}
.ao h2.ttl em { font-style: italic; font-weight: 300; color: var(--rose); }
.ao .sub {
  margin-top: 16px; color: var(--muted);
  font-size: 17px; line-height: 1.75;
}

.ao .btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 54px; padding: 0 32px; border-radius: 999px;
  font-size: 14px; font-weight: 800; letter-spacing: .04em;
  text-transform: uppercase; cursor: pointer; border: none;
  transition: all var(--t); text-decoration: none; white-space: nowrap;
}
.ao .btn-rose {
  background: var(--rose); color: #fff;
  box-shadow: 0 10px 30px rgba(194,90,112,.35);
  animation: ao-breath 2.8s ease-in-out infinite;
}
.ao .btn-rose:hover { background: var(--rose-d); transform: translateY(-2px); box-shadow: 0 16px 38px rgba(194,90,112,.45); }
.ao .btn-outline-d { background: transparent; color: var(--deep); border: 2px solid var(--deep); }
.ao .btn-outline-d:hover { background: var(--deep); color: #fff; }
.ao .btn-outline-w { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.35); }
.ao .btn-outline-w:hover { background: rgba(255,255,255,.1); }
.ao .btn-dark { background: var(--deep); color: #fff; box-shadow: var(--sh-m); }
.ao .btn-dark:hover { background: var(--navy); transform: translateY(-2px); }

@keyframes ao-breath {
  0%,100% { box-shadow: 0 10px 28px rgba(194,90,112,.32); }
  50%      { box-shadow: 0 16px 40px rgba(194,90,112,.50); }
}
@keyframes ao-float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-12px); }
}
@keyframes ao-in {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════════════════════════════════
   §1  HERO
═══════════════════════════════════════════════════════════════ */
.ao__hero {
  background: var(--cream);
  padding: 80px 24px 100px;
  position: relative; overflow: hidden;
}
.ao__hero::before {
  content: ""; pointer-events: none;
  position: absolute; top: -160px; right: -160px;
  width: 700px; height: 700px; border-radius: 50%;
  background: radial-gradient(circle, rgba(245,198,208,.4) 0%, transparent 65%);
}
.ao__hero::after {
  content: ""; pointer-events: none;
  position: absolute; bottom: -120px; left: -80px;
  width: 500px; height: 500px; border-radius: 50%;
  background: radial-gradient(circle, rgba(184,146,90,.1) 0%, transparent 65%);
}
.ao__hero .wrap { position: relative; z-index: 1; }

.ao__hero-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 56px; align-items: center;
}
.ao__hero-stars {
  display: flex; align-items: center; gap: 8px; margin-bottom: 20px;
}
.ao__hero-stars .stars { color: #d4a54a; font-size: 17px; letter-spacing: 1px; }
.ao__hero-stars span { color: var(--muted); font-size: 13px; font-weight: 600; }
.ao__hero h1 {
  margin: 0; font-size: clamp(38px, 5.2vw, 70px);
  line-height: .97; font-weight: 900; letter-spacing: -.05em;
}
.ao__hero h1 em { font-style: italic; font-weight: 300; color: var(--rose); display: block; }
.ao__hero-lead {
  margin-top: 22px; color: var(--muted); font-size: 17px; line-height: 1.72;
  max-width: 42ch;
}
.ao__hero-pills {
  display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px;
}
.ao__pill {
  display: inline-flex; align-items: center; gap: 5px;
  height: 32px; padding: 0 14px; border-radius: 999px;
  background: var(--white); border: 1px solid var(--border);
  font-size: 12px; font-weight: 700; color: var(--deep);
  box-shadow: var(--sh-s);
}
.ao__hero-actions {
  display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 30px;
}
.ao__hero-note {
  margin-top: 14px; color: var(--muted); font-size: 12px; display: flex; align-items: center; gap: 6px;
}
.ao__hero-note::before { content: "🛡️"; font-size: 13px; }

/* visual side */
.ao__hero-visual { display: flex; flex-direction: column; align-items: center; gap: 20px; }
.ao__product-frame {
  width: 100%; max-width: 460px; aspect-ratio: 1;
  border-radius: var(--r-l); overflow: hidden;
  background: linear-gradient(145deg, #fce6ec, #f9f0f4, #ede9f5);
  box-shadow: var(--sh-l);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.ao__product-frame::after {
  content: ""; pointer-events: none;
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 50% 35%, rgba(194,90,112,.1), transparent 60%);
}
.ao__product-frame img {
  width: 88%; height: 88%; object-fit: contain; position: relative; z-index: 1;
  animation: ao-float 7s ease-in-out infinite;
}
.ao__product-frame .ph {
  width: 72%; aspect-ratio: 1; border-radius: var(--r-m);
  background: linear-gradient(135deg, var(--rose-l), var(--rose));
  display: flex; align-items: center; justify-content: center;
  font-size: 72px; position: relative; z-index: 1;
  animation: ao-float 7s ease-in-out infinite;
}
.ao__price-card {
  width: 100%; max-width: 460px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--r-m); padding: 22px 26px;
  box-shadow: var(--sh-m); display: flex; gap: 16px; align-items: center;
}
.ao__price-card-label { flex: 1; }
.ao__price-card-label strong { display: block; font-size: 15px; font-weight: 800; color: var(--deep); }
.ao__price-card-label span { font-size: 13px; color: var(--muted); }
.ao__price-nums {
  display: flex; align-items: center; gap: 10px; flex-shrink: 0;
}
.ao__price-nums .old { color: #bbb; text-decoration: line-through; font-size: 16px; font-weight: 600; }
.ao__price-nums .cur { color: var(--deep); font-size: 30px; font-weight: 900; letter-spacing: -.04em; line-height: 1; }
.ao__price-badge {
  height: 28px; padding: 0 12px; border-radius: 999px;
  background: var(--rose); color: #fff; font-size: 12px; font-weight: 800;
  display: inline-flex; align-items: center; flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════════
   §2  TRUST BAR
═══════════════════════════════════════════════════════════════ */
.ao__trust {
  background: var(--white);
  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  padding: 18px 24px;
}
.ao__trust-list {
  max-width: 1200px; margin: 0 auto;
  display: flex; justify-content: center; flex-wrap: wrap;
}
.ao__trust-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 28px; border-right: 1px solid var(--border);
}
.ao__trust-item:last-child { border-right: none; }
.ao__trust-icon { font-size: 20px; line-height: 1; flex-shrink: 0; }
.ao__trust-text strong { display: block; font-size: 13px; font-weight: 800; color: var(--deep); }
.ao__trust-text span { display: block; font-size: 11px; color: var(--muted); }

/* ═══════════════════════════════════════════════════════════════
   §3  PROBLEMA → SOLUCIÓN
═══════════════════════════════════════════════════════════════ */
.ao__problem {
  background: var(--deep); padding: 100px 24px;
  position: relative; overflow: hidden;
}
.ao__problem::before {
  content: ""; pointer-events: none;
  position: absolute; top: -100px; right: -100px;
  width: 500px; height: 500px; border-radius: 50%;
  background: radial-gradient(circle, rgba(194,90,112,.14), transparent 65%);
}
.ao__problem .wrap { position: relative; z-index: 1; }
.ao__problem .eyebrow { color: var(--rose-l); }
.ao__problem h2.ttl { color: var(--white); }
.ao__problem h2.ttl em { color: var(--rose-l); }
.ao__problem .sub { color: rgba(255,255,255,.65); }

.ao__problem-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 36px; margin-top: 52px; align-items: start;
}
.ao__problem-quote {
  font-size: clamp(19px, 2.2vw, 24px); line-height: 1.5;
  font-style: italic; color: var(--white);
  border-left: 3px solid var(--rose); padding-left: 22px; margin: 0 0 28px;
}
.ao__problem-text { color: rgba(255,255,255,.72); font-size: 16px; line-height: 1.75; margin-bottom: 16px; }
.ao__pcards { display: grid; gap: 14px; }
.ao__pcard {
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
  border-radius: var(--r-m); padding: 22px;
  display: flex; align-items: flex-start; gap: 16px;
  transition: background var(--t);
}
.ao__pcard:hover { background: rgba(255,255,255,.08); }
.ao__pcard-icon { font-size: 28px; line-height: 1; flex-shrink: 0; }
.ao__pcard h4 { margin: 0 0 5px; color: var(--white); font-size: 15px; font-weight: 800; }
.ao__pcard p { color: rgba(255,255,255,.65); font-size: 14px; line-height: 1.62; }

.ao__sol {
  background: rgba(194,90,112,.08); border: 1px solid rgba(194,90,112,.2);
  border-radius: var(--r-l); padding: 32px 30px;
}
.ao__sol-head {
  font-size: 11px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase;
  color: var(--rose-l); margin-bottom: 22px; display: flex; align-items: center; gap: 8px;
}
.ao__sol-items { display: grid; gap: 18px; }
.ao__sol-item { display: flex; align-items: flex-start; gap: 14px; }
.ao__sol-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--rose); flex-shrink: 0; margin-top: 5px;
}
.ao__sol-item p { color: var(--white); font-size: 15px; line-height: 1.65; }
.ao__sol-item strong { color: var(--rose-l); }

.ao__problem-cta { text-align: center; margin-top: 52px; }

/* ═══════════════════════════════════════════════════════════════
   §4  TECNOLOGÍA DUAL
═══════════════════════════════════════════════════════════════ */
.ao__tech { background: var(--white); padding: 100px 24px; }
.ao__tech-head { text-align: center; max-width: 640px; margin: 0 auto 56px; }
.ao__tech-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
}
.ao__tcard {
  border-radius: var(--r-l); padding: 44px 40px;
  position: relative; overflow: hidden;
  transition: box-shadow var(--t), transform var(--t);
}
.ao__tcard:hover { box-shadow: var(--sh-l); transform: translateY(-4px); }
.ao__tcard.red  { background: var(--blush); border: 1px solid rgba(194,90,112,.15); }
.ao__tcard.blue { background: #f0f0ff; border: 1px solid rgba(100,100,220,.1); }
.ao__tcard::before {
  content: ""; pointer-events: none;
  position: absolute; top: -50px; right: -50px;
  width: 200px; height: 200px; border-radius: 50%; opacity: .2;
}
.ao__tcard.red::before  { background: var(--rose); }
.ao__tcard.blue::before { background: #7b7bef; }
.ao__tcard-n {
  font-size: 88px; font-weight: 900; line-height: 1;
  letter-spacing: -.07em; margin-bottom: 14px; opacity: .12;
}
.ao__tcard.red  .ao__tcard-n { color: var(--rose); }
.ao__tcard.blue .ao__tcard-n { color: #7b7bef; }
.ao__tcard-badge {
  display: inline-flex; align-items: center; gap: 7px;
  height: 30px; padding: 0 14px; border-radius: 999px;
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em;
  margin-bottom: 18px;
}
.ao__tcard.red  .ao__tcard-badge { background: rgba(194,90,112,.12); color: var(--rose-d); }
.ao__tcard.blue .ao__tcard-badge { background: rgba(123,123,239,.1); color: #5a5aaa; }
.ao__tcard h3 { margin: 0 0 14px; font-size: 26px; font-weight: 800; letter-spacing: -.04em; color: var(--deep); }
.ao__tcard > p { color: var(--muted); font-size: 15px; line-height: 1.72; }
.ao__tcard-specs { display: grid; gap: 10px; margin-top: 22px; }
.ao__tcard-spec { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--deep); }
.ao__tcard-spec::before {
  content: ""; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
}
.ao__tcard.red  .ao__tcard-spec::before { background: var(--rose); }
.ao__tcard.blue .ao__tcard-spec::before { background: #7b7bef; }

/* ═══════════════════════════════════════════════════════════════
   §5  TIMELINE RESULTADOS
═══════════════════════════════════════════════════════════════ */
.ao__results { background: var(--cream); padding: 100px 24px; }
.ao__results-head { text-align: center; max-width: 600px; margin: 0 auto 56px; }
.ao__timeline { position: relative; padding-left: 52px; }
.ao__timeline::before {
  content: ""; position: absolute; left: 19px; top: 10px; bottom: 10px; width: 2px;
  background: linear-gradient(to bottom, var(--rose-l), var(--rose), var(--rose-l));
}
.ao__week {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--r-m); padding: 32px 34px; margin-bottom: 20px;
  position: relative; transition: box-shadow var(--t);
}
.ao__week:hover { box-shadow: var(--sh-m); }
.ao__week:last-child { margin-bottom: 0; }
.ao__week::before {
  content: ""; position: absolute; left: -41px; top: 32px;
  width: 20px; height: 20px; border-radius: 50%;
  border: 3px solid var(--cream); z-index: 1;
}
.ao__week:nth-child(1)::before { background: var(--rose-l); }
.ao__week:nth-child(2)::before { background: var(--rose); }
.ao__week:nth-child(3)::before { background: var(--deep); }
.ao__week-emoji { float: right; font-size: 38px; margin: -4px 0 12px 16px; line-height: 1; }
.ao__week-tag {
  display: inline-flex; align-items: center;
  height: 24px; padding: 0 12px; border-radius: 999px;
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em;
  margin-bottom: 12px;
}
.ao__week:nth-child(1) .ao__week-tag { background: rgba(194,90,112,.1); color: var(--rose-d); }
.ao__week:nth-child(2) .ao__week-tag { background: var(--rose); color: #fff; }
.ao__week:nth-child(3) .ao__week-tag { background: var(--deep); color: #fff; }
.ao__week h3 { margin: 0 0 10px; font-size: 22px; font-weight: 800; letter-spacing: -.03em; color: var(--deep); }
.ao__week p  { color: var(--muted); font-size: 15px; line-height: 1.7; }
.ao__week small { display: block; margin-top: 12px; color: #aaa; font-size: 12px; }
.ao__results-cta { text-align: center; margin-top: 48px; }

/* ═══════════════════════════════════════════════════════════════
   §6  TESTIMONIOS
═══════════════════════════════════════════════════════════════ */
.ao__reviews { background: var(--white); padding: 100px 24px; }
.ao__reviews-head { text-align: center; max-width: 620px; margin: 0 auto 14px; }
.ao__reviews-bar {
  display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 52px;
}
.ao__reviews-bar .stars { color: #d4a54a; font-size: 20px; letter-spacing: 2px; }
.ao__reviews-bar span { color: var(--muted); font-size: 14px; font-weight: 600; }
.ao__review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.ao__rcard {
  background: var(--cream); border: 1px solid var(--border);
  border-radius: var(--r-m); padding: 30px 28px;
  transition: box-shadow var(--t), transform var(--t);
}
.ao__rcard:hover { box-shadow: var(--sh-m); transform: translateY(-3px); }
.ao__rcard.featured { border-color: var(--rose-l); background: var(--blush); box-shadow: var(--sh-m); }
.ao__rcard .verified {
  display: inline-flex; align-items: center; gap: 5px;
  height: 22px; padding: 0 10px; border-radius: 999px;
  background: rgba(45,168,122,.1); color: var(--green);
  font-size: 11px; font-weight: 700; margin-bottom: 14px;
}
.ao__rcard-stars { color: #d4a54a; font-size: 15px; margin-bottom: 10px; }
.ao__rcard-week {
  display: inline-flex; align-items: center; gap: 5px;
  background: var(--white); border: 1px solid var(--border); border-radius: 8px;
  height: 24px; padding: 0 10px; font-size: 11px; font-weight: 700; color: var(--muted);
  margin-bottom: 14px;
}
.ao__rcard blockquote {
  margin: 0 0 20px; font-size: 15px; line-height: 1.7;
  color: var(--deep); font-style: italic;
}
.ao__rcard-author { display: flex; align-items: center; gap: 12px; }
.ao__avatar {
  width: 42px; height: 42px; border-radius: 50%;
  background: linear-gradient(135deg, var(--rose-l), var(--rose));
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; font-weight: 900; color: #fff; flex-shrink: 0;
}
.ao__rcard-name { font-size: 14px; font-weight: 800; color: var(--deep); }
.ao__rcard-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ═══════════════════════════════════════════════════════════════
   §7  CÓMO USAR
═══════════════════════════════════════════════════════════════ */
.ao__how { background: var(--deep); padding: 100px 24px; position: relative; overflow: hidden; }
.ao__how::after {
  content: ""; pointer-events: none;
  position: absolute; bottom: -80px; right: -80px;
  width: 420px; height: 420px; border-radius: 50%;
  background: radial-gradient(circle, rgba(194,90,112,.12), transparent 65%);
}
.ao__how .wrap { position: relative; z-index: 1; }
.ao__how .eyebrow { color: var(--rose-l); }
.ao__how h2.ttl { color: var(--white); }
.ao__how h2.ttl em { color: var(--rose-l); }
.ao__how-head { text-align: center; max-width: 580px; margin: 0 auto 56px; }
.ao__steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
.ao__step {
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.09);
  border-radius: var(--r-m); padding: 28px 18px; text-align: center;
  transition: background var(--t);
}
.ao__step:hover { background: rgba(255,255,255,.09); }
.ao__step-icon {
  width: 60px; height: 60px; border-radius: 50%;
  background: rgba(194,90,112,.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 26px; margin: 0 auto 16px;
}
.ao__step-n { color: var(--rose); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 10px; }
.ao__step h4 { margin: 0 0 8px; color: var(--white); font-size: 15px; font-weight: 800; letter-spacing: -.02em; }
.ao__step p { color: rgba(255,255,255,.62); font-size: 13px; line-height: 1.62; }
.ao__how-note {
  background: rgba(194,90,112,.08); border: 1px solid rgba(194,90,112,.18);
  border-radius: var(--r-m); padding: 20px 28px; margin-top: 32px; text-align: center;
  color: rgba(255,255,255,.8); font-size: 14px; line-height: 1.6;
}
.ao__how-note strong { color: var(--rose-l); }

/* ═══════════════════════════════════════════════════════════════
   §8  ESPECIFICACIONES
═══════════════════════════════════════════════════════════════ */
.ao__specs { background: var(--cream); padding: 100px 24px; }
.ao__specs-head { text-align: center; max-width: 600px; margin: 0 auto 48px; }
.ao__specs-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
.ao__spec-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.ao__spec-card {
  background: var(--white); border: 1px solid var(--border);
