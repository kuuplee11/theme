═══════════════════════════════════════════════════════════════ */
.ao__sticky {
  display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999;
  background: var(--deep); border-top: 1px solid rgba(255,255,255,.12);
  padding: 12px 16px; box-shadow: 0 -8px 32px rgba(18,18,32,.2);
